# Copy this file to .env.local and fill in real values before launch.

# WhatsApp number in international format without "+" (e.g. 51987654321)
NEXT_PUBLIC_WHATSAPP_NUMBER="51[NUMERO]"
NEXT_PUBLIC_WHATSAPP_MESSAGE="Hola, quiero reservar mi cupo para la Experiencia Origen"

# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=[META_PIXEL_ID]

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=[GA4_MEASUREMENT_ID]

# Production domain, used for metadata/Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://[DOMINIO].com"
